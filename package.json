{
    "name": "node-cosmos",
    "version": "0.1.7",
    "description": "A light weight azure cosmosdb client aiming at ease of use for creating REST API. Supports json filter, sort and offset/limit",
    "homepage": "https://github.com/thunderz99/node-cosmos",
    "repository": {
        "type": "git",
        "url": "https://github.com/thunderz99/node-cosmos"
    },
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "pretest": "tsc",
        "test": "jest --coverage",
        "lint": "eslint .",
        "test:unit": "npm run build && jest --config jest.unit.config.js --runInBand --watchman=false --coverage",
        "test:integration": "npm run build && jest --config jest.integration.config.js --runInBand --watchman=false --coverage",
        "audit:dependencies": "npm audit --audit-level=low"
    },
    "keywords": [
        "cosmosdb",
        "mongodb",
        "cosmos",
        "azure",
        "documentdb",
        "client",
        "sdk",
        "typescript",
        "node",
        "light"
    ],
    "dependencies": {
        "@azure/cosmos": "4.10.1",
        "mongodb": "6.21.0",
        "pg": "8.23.1",
        "randomstring": "1.3.2",
        "uuid": "11.1.1"
    },
    "devDependencies": {
        "@types/jest": "29.5.14",
        "@types/node": "22.20.5",
        "@types/pg": "8.23.1",
        "@types/randomstring": "1.3.0",
        "@typescript-eslint/eslint-plugin": "8.72.0",
        "@typescript-eslint/parser": "8.72.0",
        "dotenv": "^8.2.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.7",
        "jest": "29.7.0",
        "prettier": "3.9.10",
        "ts-jest": "29.4.15",
        "typescript": "5.9.3",
        "globals": "17.13.0"
    },
    "author": "Zhang Lei <thunderz99@gmail.com>",
    "license": "MIT",
    "engines": {
        "node": ">=22.13.0"
    },
    "packageManager": "npm@10.9.9"
}
